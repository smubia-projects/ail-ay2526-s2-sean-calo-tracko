# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL (Cloud Run service URL, e.g. https://calo-tracko-xxx.run.app)
WEBHOOK_URL=https://your-cloud-run-url.run.app

# Access Control / Security
REQUIRE_AUTH=True
AUTHORIZED_TELEGRAM_IDS=your_telegram_id_here,another_id_here

# AI Model Aggregator API Settings (OpenAI-compatible)
API_KEY=your_api_key_here
API_BASE_URL=https://api.example.com/v1
MODEL_NAME=gpt-4o-mini
VISION_MODEL_NAME=gpt-4o

# Neon DB (Postgres) — append ?sslmode=require for Neon
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Upstash Redis (rate limiting) — leave empty to disable rate limiting locally.
# Shared engine: limits are read from the central control sheet at runtime, with
# the values below as fallbacks. See DOCS/shared/rate-limit/central-config.md
# Use the names from the Upstash dashboard (REST_); the short names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit tuning (optional, fallback defaults shown)
# RATE_LIMIT_EST_MAX=5            # max AI estimates per user per window
# RATE_LIMIT_WINDOW_SECONDS=432000  # 5 days
